APP_NAME=Document Consistency Checker
ENVIRONMENT=development
LOG_LEVEL=INFO
# Development upload location defaults to backend/.uploads (ignored by Git).
# UPLOAD_DIR=D:/document-consistency-checker/backend/.uploads
MAX_UPLOAD_BYTES=52428800
PROCESSING_WORKERS=1
LLM_MAX_CONCURRENCY=5
LLM_QUEUE_TIMEOUT_SECONDS=30
# Shared per-process budget across extraction, verification and embedding HTTP attempts.

# Backend-only PDF storage. Local remains the development default.
DOCUMENT_STORAGE=local
# To use Supabase, create a PRIVATE bucket and set DOCUMENT_STORAGE=supabase.
SUPABASE_URL=
# SUPABASE_URL is only required when DOCUMENT_STORAGE=supabase.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
STORAGE_TIMEOUT_SECONDS=60

# Model credentials use the BACKEND PROCESS ENVIRONMENT ONLY, not this dotenv file.
# Default provider: LLM_PROVIDER=gemini
# Set GEMINI_API_KEY in the backend terminal or secret manager.
# Supported defaults: GEMINI_MODEL=gemini-3.8-flash
# Local embeddings are always used by document workers.
# Optional OpenAI: LLM_PROVIDER=openai, OPENAI_API_KEY, OPENAI_MODEL=gpt-4o-mini,
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2.
# Optional process settings (defaults shown):
# EXTRACTION_TIMEOUT_SECONDS=60
# EXTRACTION_MAX_RETRIES=2
# EXTRACTION_BACKOFF_SECONDS=1
# EXTRACTION_BACKOFF_CAP_SECONDS=30
# EXTRACTION_MAX_OUTPUT_TOKENS=8192
# EXTRACTION_CACHE_PATH=path/to/claims.sqlite3

# Embedding process environment settings (credentials are not read from this file):
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_SIMILARITY_THRESHOLD=0.80
# EMBEDDING_TIMEOUT_SECONDS=60
# EMBEDDING_MAX_RETRIES=2
# EMBEDDING_CACHE_PATH=path/to/embeddings.sqlite3

# Verification uses the selected provider's text model unless overridden.
# VERIFICATION_MODEL=gemini-3.8-flash
# VERIFICATION_TIMEOUT_SECONDS=60
# VERIFICATION_MAX_RETRIES=2
# VERIFICATION_MAX_OUTPUT_TOKENS=8192
# VERIFICATION_MAX_CONTEXT_CHARACTERS=120000

# Optional. Leave empty to run the API without a database.
DATABASE_URL=
# Only for the optional local compose.yaml database. Use a generated password,
# and use the same password in DATABASE_URL (URL-encoded if necessary).
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://document_app:PASSWORD@127.0.0.1:5433/document_consistency
# Local PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/document_consistency
# Supabase: use the connection details from your project's database settings.
# DATABASE_URL=postgresql+psycopg://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# URL-encode special characters in credentials. Never commit real credentials.

# Local-first cascade (process environment):
# CANDIDATE_SCORE_THRESHOLD=0.65
# VERIFICATION_BATCH_SIZE=8
# VERIFICATION_REQUEST_BUDGET=10
